{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-Content-Type-Options",     "value": "nosniff" },
        { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",         "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-XSS-Protection",           "value": "1; mode=block" },
        { "key": "Content-Security-Policy",    "value": "default-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://cdn.vercel-analytics.com; img-src 'self' data: https://terrenovalenca.com.br; frame-src https://www.openstreetmap.org; connect-src 'self' https://cdn.vercel-analytics.com https://va.vercel-analytics.com; base-uri 'self'; form-action 'none'; object-src 'none'" }
      ]
    },
    {
      "source": "/(.+\\.(jpeg|jpg|png|webp|svg|ico|gif))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.+\\.(css|js|woff2|woff|ttf))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt|\\.well-known/security\\.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type",  "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
